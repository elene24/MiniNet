<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>AppointmentsApi</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MiniNet\MiniNet.csproj" />
    <InternalsVisibleTo Include="AppointmentsApi.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- The SQL Server driver is only needed when APPOINTMENTS_CONNECTION_STRING is set.
         Build with -p:OfflineBuild=true to skip it (the in-memory repository needs no packages). -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.0.1" Condition="'$(OfflineBuild)' != 'true'" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\infra\sql\schema.sql" LogicalName="schema.sql" />
  </ItemGroup>
</Project>
